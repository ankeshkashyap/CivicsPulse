# CivicPulse Root Environment Configuration Template
# Copy this file to .env in backend/ and frontend/ as needed

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Frontend Settings
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1/ws

# -----------------------------------------------------------------------------
# Backend & API Settings
# -----------------------------------------------------------------------------
PROJECT_NAME="CivicPulse API"
API_V1_STR=/api/v1
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# -----------------------------------------------------------------------------
# Format: postgresql+asyncpg://user:password@localhost:5432/civicpulse_db
# Or sync for migrations: postgresql://user:password@localhost:5432/civicpulse_db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/civicpulse_dev

# -----------------------------------------------------------------------------
# Future Integrations (Placeholders for upcoming phases)
# -----------------------------------------------------------------------------
# Email / OTP Provider (e.g., console | smtp | resend)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@civicpulse.org

# Cloudinary (Image evidence storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=civicpulse/complaints

# Real-time WebSocket settings
WS_HEARTBEAT_INTERVAL=30
