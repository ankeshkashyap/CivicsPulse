# CivicPulse Backend Environment Variables
ENVIRONMENT=development
LOG_LEVEL=INFO
PROJECT_NAME="CivicPulse API"
API_V1_STR=/api/v1

# Security
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection (PostGIS enabled PostgreSQL)
# Replace USER and PASSWORD with your configured credentials
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/civicpulse_dev

# Integrations (Placeholders for subsequent phases)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@civicpulse.org

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=civicpulse/complaints

WS_HEARTBEAT_INTERVAL=30